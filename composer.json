{
    "name": "ocolin/global-type",
    "description": "Simple library for making sure global variables are of a specific type",
    "require-dev": {
        "phpunit/phpunit": "^13",
        "phpstan/phpstan": "^2.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ocolin\\GlobalType\\": "src/"
        }
    },
  "autoload-dev": {
    "psr-4": {
      "Ocolin\\GlobalType\\Tests\\": "tests/"
    }
  },
    "authors": [
        {
            "name": "Colin Miller",
            "email": "ocolin@cruzio.com"
        }
    ],
    "require": {
        "php": "^8.0"
    },
  "scripts": {
    "test": "vendor/bin/phpunit --no-coverage --display-deprecations --display-notices",
    "test-coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-html coverage"
  }
}
